# Environment
ENVIRONMENT=development
PORT=8000

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-strong-secret-key-at-least-32-bytes
ENCRYPTION_KEY=change-me-32-byte-fernet-compatible-key-placeholder=

# Database & Cache
# Local Docker or Neon connection string:
DATABASE_URL=postgresql+asyncpg://quotient:quotient_dev_password@localhost:5432/quotient
# Upstash or local Redis:
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://quotient.vercel.app

# Frontend Config
VITE_API_URL=http://localhost:8000
VITE_ENABLE_DEV_WINDOW_MAP=true
